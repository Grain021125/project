/* QDialog#LoginDialog,
#RegisterDialog {
} */

#user_label,
#pass_label {
    color: rgb(255, 255, 255);
}

#error_label[state='normal']{
    color: green;
}

#error_label[state='err']{
    color: red;
}

/* ========== Global ========== */
* {
    outline: 0;
}
QWidget {
    background: #f5f7fb;
    color: #323232;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", "Arial";
    font-size: 13px;
}

#side_bar{
    background: #f7f9fc;
    border-right: 1px solid #e6eaf0;
}

#search_edit {
    background: #f5f7fb;
    border: 1px solid #e6eaf0;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: rgba(18,183,245,0.20);
}

#chat_user_wid {
    background: transparent;
    border: none;
}
#chat_user_wid::item{
    height: 56px;
    margin: 2px 6px;
    padding: 6px 10px;
    border-radius: 10px;
    color: #323232;
}
#chat_user_wid::item:hover {
    background: rgba(18,183,245,0.08);
}
#chat_user_wid::item:selected {
    background: rgba(18,183,245,0.12);
}

#chat_data_list {
    background: #fcfcff;
}

#chat_user_list {
    background: #f7f9fc;
    border-right: 1px solid #e6eaf0;
}

#search_list {
    background: #f7f9fc;
}

#tool_wid {
    background: #f7f9fc;
    color: #323232;
    border: 1px solid #e6eaf0;
    border-radius: 6px;
    padding: 6px 8px;
}

#chat_data_wid {
    background: #f7f9fc;
    border-top: 1px solid #e6eaf0;
}

#chatEdit {
    background: #f7f9fc;
    border: 1px solid #e6eaf0;
    border-radius: 10px;
    padding: 6px 8px;
    selection-background-color: rgba(18,183,245,0.20);
}

#send_btn, #recv_btn {
    background: #12b7f5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 76px;
    font-weight: 600;
}

#send_btn:hover, #recv_btn:hover {
    background: #0ea5e9;
}

#send_btn:pressed, #recv_btn:pressed {
    background: #0c94d2;;
}

#send_wid{
    background: #f7f9fc;
    border: none; /* 隐藏边框 */
}



/* 搜索框*/
#search_wid {
    background: #f7f9fc;
    border: 1px solid #e6eaf0;
    border-radius: 8px;
    padding: 6px 10px;
}
#search_edit {
    border: 2px solid #f1f1f1;
}

#add_btn[state='normal'] {
    border-image: url(:res/add_friend_normal.png);
}

#add_btn[state='hover'] {
    border-image: url(:res/add_friend_hover.png);
}

#add_btn[state='press'] {
    border-image: url();
}

#emoj_lab{
    border-image: url(:/res/smile.png);
}

#file_lab{
    border-image: url(:/res/filedir.png);
}

#side_chat_lab {
    border-image: url(:/res/chat_icon.png);
}

#side_contact_lab{
    border-image: url(:/res/contact_list.png);
}