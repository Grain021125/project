#user_label,
#pass_label {
    color: rgb(255, 255, 255);
}

#error_label[state='normal'] {
    color: green;
}

#error_label[state='err'] {
    color: red;
}

/* ========== Global ========== */

#side_bar {
    background: #f7f9fc;
    border-right: 1px solid #e6eaf0;
}

#search_edit {
    background: #f5f7fb;
    border: 1px solid #e6eaf0;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: rgba(18, 183, 245, 0.20);
}

#chat_user_wid {
    background: transparent;
    border: none;
}

#chat_user_wid::item {
    height: 56px;
    margin: 2px 6px;
    padding: 6px 10px;
    border-radius: 10px;
    color: #323232;
}

#chat_user_wid::item:hover {
    background: rgba(18, 183, 245, 0.08);
}

#chat_user_wid::item:selected {
    background: rgba(18, 183, 245, 0.12);
}

#chat_data_wid #title_lab {
    font-family: "Microsoft YaHei";
    color: #323232;
    font-size: 18px;
    font-weight: normal;
}

#chat_data_list {
    background: #fcfcff;
}

#chat_user_list {
    background: #f7f9fc;
    border-right: 1px solid #e6eaf0;
}

#search_list {
    background: #f7f9fc;
}

#tool_wid {
    background: #f7f9fc;
    color: #323232;
    border-bottom: 1px solid #e6eaf0;
    padding: 6px 8px;
}

#chat_data_wid {
    background: #f7f9fc;
    border-top: 1px solid #e6eaf0;
}

#chatEdit {
    background: #f7f9fc;
    color: #323232;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", "Arial";
    border: none;
    selection-background-color: rgba(18, 183, 245, 0.20);
}

#send_button,
#recv_button {
    background: #12b7f5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 76px;
    font-weight: 600;
}

#send_button:hover,
#recv_button:hover {
    background: #0ea5e9;
}

#send_button:pressed,
#recv_button:pressed {
    background: #0c94d2;
    ;
}

#send_wid {
    background: #f7f9fc;
}



